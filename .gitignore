# Package.resolved is deliberately NOT ignored: dependencies are pinned, and a
# lockfile that is not committed pins nothing.

# Generated by XcodeGen — the source of truth is apps/ios/project.yml.
# Never edit these by hand; `make ios-project` rewrites them.
apps/ios/Knotwork.xcodeproj/
apps/ios/App/Info.plist

# peru's cache and state. peru.yaml, and the files it imports, are committed.
.peru/

